# AI Data Assistant Backend Environment Variables
# 复制此文件为 .env 并填入实际值

# ==============================================
# 应用配置
# ==============================================
FLASK_CONFIG=development
FLASK_DEBUG=true
SECRET_KEY=your-very-secret-key-change-this-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production

# ==============================================
# 服务器配置
# ==============================================
HOST=0.0.0.0
PORT=5000

# ==============================================
# 数据库配置
# ==============================================
# 开发环境 - SQLite (默认，注释掉以使用)
# DATABASE_URL=sqlite:///app.db

# 生产环境 - PostgreSQL (取消注释并填入实际值)
# DATABASE_URL=postgresql://username:password@localhost:5432/fumadocs_ai

# 本地PostgreSQL示例
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/fumadocs_ai

# ==============================================
# 邮件服务配置 (用于邮箱验证和密码重置)
# ==============================================
# Gmail SMTP配置
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# 其他邮件服务商示例：
# Outlook/Hotmail
# MAIL_SERVER=smtp-mail.outlook.com
# MAIL_PORT=587
# QQ邮箱
# MAIL_SERVER=smtp.qq.com
# MAIL_PORT=587

# ==============================================
# 文件上传配置
# ==============================================
UPLOAD_FOLDER=storage/uploads
MAX_CONTENT_LENGTH=16777216
# 16MB = 16 * 1024 * 1024 bytes

# 允许的文件扩展名 (逗号分隔)
ALLOWED_EXTENSIONS=csv,xlsx,xls

# ==============================================
# 前端集成配置
# ==============================================
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==============================================
# 安全配置
# ==============================================
# JWT令牌过期时间 (秒)
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# 密码重置令牌过期时间 (秒)
PASSWORD_RESET_EXPIRES=3600

# 邮箱验证令牌过期时间 (秒)
EMAIL_VERIFICATION_EXPIRES=86400

# ==============================================
# 图表配置
# ==============================================
CHART_DPI=150
CHART_FORMAT=png

# ==============================================
# 会话配置
# ==============================================
SESSION_TIMEOUT_HOURS=2

# ==============================================
# 分析配置
# ==============================================
MAX_PREVIEW_ROWS=5
MAX_CORRELATION_FEATURES=20

# ==============================================
# 日志配置
# ==============================================
LOG_LEVEL=INFO